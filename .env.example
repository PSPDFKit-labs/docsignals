# Copy to .env and fill in. .env is ignored by git.
# docsignals does not load this file. Load it into your shell before a run:
#   set -a; source .env; set +a

# Nutrient DWS key that is authorised for Data Extraction. Extraction always calls DWS,
# also with --fake, unless --cache-dir has the document. https://www.nutrient.io/api/
NUTRIENT_EXTRACTION_API_KEY=

# Jev key. Not necessary with --fake. https://typesafe.ai/
TYPESAFE_API_KEY=

# Optional. Points the Jev client at another server, such as tools/laya-server.
# With the local server, set TYPESAFE_API_KEY=local.
# TYPESAFE_BASE_URL=http://127.0.0.1:8484
