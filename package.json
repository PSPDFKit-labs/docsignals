{
  "name": "@nutrient-sdk/docsignals",
  "version": "0.1.0",
  "description": "Ask typed questions of your documents. Get answers with probabilities.",
  "keywords": [
    "documents",
    "pdf",
    "extraction",
    "classification",
    "jev",
    "system-one",
    "nutrient",
    "dws"
  ],
  "license": "MIT",
  "author": "Nutrient (https://www.nutrient.io)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "docsignals": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "packs"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm test",
    "docsignals": "tsx src/cli.ts"
  },
  "dependencies": {
    "@nutrient-sdk/dws-client-typescript": "^3.0.0",
    "@typesafe-ai/sdk": "^0.6.0",
    "yaml": "^2.8.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
